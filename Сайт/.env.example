# Приклад змінних середовища. Скопіюйте в .env.local (локально) або додайте у Vercel → Settings → Environment Variables.
# Файли .env* вже в .gitignore, у git вони не потрапляють. Справжні токени сюди не вписуйте.

# --- Сайт (браузер). Це не секрети: ідентифікатор проєкту видно в кожному запиті до Sanity ---
VITE_SANITY_PROJECT_ID=ifvo36e6
VITE_SANITY_DATASET=production

# --- Сервер замовлень (api/order.js), тільки у Vercel, з позначкою Sensitive ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sanity для сервера. Ідентифікатори не секретні
SANITY_PROJECT_ID=ifvo36e6
SANITY_DATASET=production

# Потрібен лише якщо датасет колись зробите приватним. Токен із правом «Viewer»
SANITY_API_READ_TOKEN=
